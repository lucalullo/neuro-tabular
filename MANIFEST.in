include .gitignore
include AGENTS.md
include CHANGELOG.md
include CITATION.cff
include CODE_OF_CONDUCT.md
include CONTRIBUTING.md
include LEGAL.md
include LICENSE
include README.md
include BENCHMARKS.md
include RELEASE_NOTES.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
recursive-include docs *.md
recursive-include benchmarks *.py *.md *.json *.lock *.csv *.png *.svg
recursive-include examples *.py
recursive-include tests *.py
include SOURCE_MANIFEST.sha256
recursive-include tools *.py
recursive-include release *.md
prune .p35-local
prune .p36-local
prune .p35-product
prune .p36-product
prune .p37-local
prune .p37-product
prune product_validation
prune docs/research
prune tests/fixtures
prune .local
prune .codex-context
